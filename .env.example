# =================================================================
# MamaRise Environment Configuration Template
# =================================================================
# Copy this file to .env and insert your Google Gemini API key:
# cp .env.example .env

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database connection URL
DATABASE_URL=sqlite:///./mamarise.db
